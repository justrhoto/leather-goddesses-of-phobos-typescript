{
  "name": "leather-goddesses-of-phobos",
  "private": true,
  "version": "0.1.0",
  "description": "A browser-native port of Infocom's Leather Goddesses of Phobos (1986), with a TypeScript Z-machine engine and a modern UI.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "play": "tsx tools/play.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
