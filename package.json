{
  "name": "leather-goddesses-of-phobos-typescript",
  "private": true,
  "version": "0.1.0",
  "description": "Infocom's Leather Goddesses of Phobos (1986), ported from its original ZIL source to TypeScript, with a modern browser interface.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "play": "tsx tools/play.ts",
    "walk": "tsx tools/walk.ts",
    "translate": "tsx tools/zil2ts/main.ts",
    "verify:dictionary": "tsx tools/verify/dictionary.ts",
    "verify:syntax": "tsx tools/verify/syntax.ts",
    "verify:objects": "tsx tools/verify/objects.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
